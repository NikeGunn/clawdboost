{
  "name": "clawdboost",
  "version": "2.0.0",
  "type": "module",
  "description": "Smart context injection plugin for OpenClaw. Automatically boost AI conversations with pattern-matched, time-aware context snippets.",
  "author": "carryonprogrammer",
  "license": "MIT",
  "keywords": [
    "clawdboost",
    "openclaw",
    "context",
    "ai",
    "assistant",
    "claude",
    "llm",
    "knowledge",
    "snippets",
    "automation",
    "context-injection",
    "ai-tools",
    "chatbot-plugin",
    "ai-assistant",
    "smart-context",
    "openclaw-plugin"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NikeGunn/clawdboost.git"
  },
  "homepage": "https://github.com/NikeGunn/clawdboost#readme",
  "bugs": {
    "url": "https://github.com/NikeGunn/clawdboost/issues"
  },
  "openclaw": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src",
    "openclaw.plugin.json",
    "README.md",
    "scripts"
  ],
  "scripts": {
    "test": "node --experimental-vm-modules node_modules/vitest/vitest.mjs run",
    "test:watch": "node --experimental-vm-modules node_modules/vitest/vitest.mjs",
    "test:standalone": "node test/standalone.test.mjs",
    "typecheck": "tsc --noEmit",
    "stats": "node scripts/check-stats.mjs"
  },
  "peerDependencies": {
    "openclaw": ">=2026.1.26"
  },
  "peerDependenciesMeta": {
    "openclaw": {
      "optional": true
    }
  },
  "devDependencies": {
    "@sinclair/typebox": "^0.34.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
