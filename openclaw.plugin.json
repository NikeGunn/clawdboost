{
  "id": "clawdboost",
  "name": "ClawdBoost",
  "description": "Smart context injection plugin — automatically boost AI conversations with pattern-matched, time-aware context snippets.",
  "version": "2.0.0",
  "kind": "context-engine",
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "enabled": {
        "type": "boolean",
        "default": true,
        "description": "Enable or disable ClawdBoost globally"
      },
      "snippetsPath": {
        "type": "string",
        "description": "Path to the snippets directory (default: ~/.openclaw/clawdboost/snippets)"
      },
      "rulesPath": {
        "type": "string",
        "description": "Path to the rules file (default: ~/.openclaw/clawdboost/rules.json)"
      },
      "maxSnippetsPerTurn": {
        "type": "number",
        "default": 5,
        "description": "Maximum number of snippets to inject per agent turn"
      },
      "maxSnippetChars": {
        "type": "number",
        "default": 2000,
        "description": "Maximum characters per injected snippet"
      },
      "enableTimeAware": {
        "type": "boolean",
        "default": true,
        "description": "Enable time-aware context (morning/evening/weekend rules)"
      },
      "enablePatternMatch": {
        "type": "boolean",
        "default": true,
        "description": "Enable pattern-matching context triggers"
      },
      "logInjections": {
        "type": "boolean",
        "default": false,
        "description": "Log when context is injected (for debugging)"
      },
      "timezone": {
        "type": "string",
        "default": "local",
        "description": "Timezone for time-aware rules (e.g., 'America/New_York' or 'local')"
      }
    }
  },
  "uiHints": {
    "snippetsPath": {
      "label": "Snippets Directory",
      "placeholder": "~/.openclaw/clawdboost/snippets",
      "advanced": true
    },
    "rulesPath": {
      "label": "Rules File Path",
      "placeholder": "~/.openclaw/clawdboost/rules.json",
      "advanced": true
    },
    "timezone": {
      "label": "Timezone",
      "placeholder": "local"
    }
  }
}
